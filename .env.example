# Dev Auth Escape Hatch
# WARNING: Set to false before any non-local deployment!
# When true, the X-Dev-Company-Id header is accepted as an alternative to JWT
# auth for company scoping. This is convenient for local curl/Postman testing
# but must NEVER be enabled in staging or production.
ALLOW_DEV_AUTH_HEADERS=true
